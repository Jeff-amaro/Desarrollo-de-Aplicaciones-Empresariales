# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git ignored, so no credential is ever committed to the repository.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database (SQLite by default)
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# Internationalization
DJANGO_LANGUAGE_CODE=es
DJANGO_TIME_ZONE=America/Lima
